# MyKafe Print Server Configuration
# Supabase Realtime: il sushi su uno scontrino a parte, tutto il resto insieme

# Supabase project (gli ordini arrivano via Supabase Realtime)
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: necessaria perché le RLS su "Order" bloccano letture/eventi anon.
# NON committare mai questo file compilato.
SUPABASE_SERVICE_ROLE_KEY=

# Stampante termica di rete (ESC/POS, porta raw 9100)
PRINTER_HOST=192.168.1.102
PRINTER_PORT=9100

# Stampante del sushi (se mancano si usa quella sopra, sempre con scontrino a parte)
PRINTER_SUSHI_IP=192.168.1.100
PRINTER_SUSHI_PORT=9100
# Categorie che vanno sullo scontrino del sushi (separate da virgola, basta che il nome le contenga)
SUSHI_CATEGORIES=Sushi,Sashimi,Roll,Nigiri

# Bip a fine scontrino (false per disattivarlo)
PRINTER_BEEP=true
PRINTER_BEEP_TIMES=3
