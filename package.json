{
  "name": "mykafe",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema di ordinazione digitale per ristoranti",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:print": "pnpm --filter print-server dev",
    "build": "pnpm --filter web build",
    "build:print": "pnpm --filter print-server build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "db:push": "pnpm --filter db db:push",
    "db:generate": "pnpm --filter db db:generate",
    "db:seed": "pnpm --filter db db:seed",
    "db:studio": "pnpm --filter db db:studio",
    "postinstall": "pnpm --filter db db:generate",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [
    "restaurant",
    "ordering",
    "qrcode",
    "kitchen-display"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "next": "16.2.0",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.88.0"
  }
}
